# Tamil AI Voice Assistant - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# ============================================================================
# LLM Backend Configuration
# ============================================================================
# Set to 'true' for local Ollama LLM, 'false' for HuggingFace API
USE_LOCAL_LLM=false

# ============================================================================
# HuggingFace Configuration (when USE_LOCAL_LLM=false)
# ============================================================================
# Get your HuggingFace token from: https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token-here

# HuggingFace model to use (Tamil-optimized models recommended)
# Options:
# - akdiwahar/KavithaSaaram-2b-it:featherless-ai (Tamil instruction-tuned)
# - meta-llama/Llama-3.2-3B-Instruct (Multilingual)
# - bigscience/bloomz-560m (Multilingual with Tamil support)
HF_MODEL_NAME=your-huggingface-model-name-here

# ============================================================================
# Ollama Configuration (when USE_LOCAL_LLM=true)
# ============================================================================
# Ollama base URL (default for Docker: http://localhost:11435)
OLLAMA_BASE_URL=your-ollama-base-url-here

# LLM model name (GGUF file or Ollama model name)
# Examples: bloom-560m.q8_0.gguf, tamil-llama, llama2
LLM_MODEL_NAME=your-ollama-llm-model-name-here

# ============================================================================
# Google Cloud Text-to-Speech Configuration
# ============================================================================
# Set to 'true' to use Google Cloud TTS (Premium voices)
# Set to 'false' to use free gTTS fallback
USE_GOOGLE_CLOUD_TTS=true

# Google Cloud TTS voice name
# Latest Chirp3 HD voices (Ultra-high quality, most natural):
#   - ta-IN-Chirp3-HD-Callirrhoe (Natural female - RECOMMENDED)
#   - ta-IN-Chirp3-HD-Achernar (Alternative female)
# WaveNet voices (Premium neural TTS):
#   - ta-IN-Wavenet-B (Premium female)
#   - ta-IN-Wavenet-A (Premium male)
# Standard voices (Good quality, cost-effective):
#   - ta-IN-Standard-A (Male)
#   - ta-IN-Standard-B (Female)
TTS_MODEL_NAME=ta-IN-Chirp3-HD-Callirrhoe

# Voice Customization (Google Cloud TTS only)
# These settings EXACTLY match the voice_comparison reference samples
TTS_SPEAKING_RATE=1.10  # Speech speed (0.25-4.0): 1.10 = 10% faster, matches reference sample
TTS_PITCH=0.0  # Voice pitch in semitones (-20 to +20). NOTE: Chirp3 HD voices don't support pitch (use 0.0)
                # For WaveNet voices: -1.0 to -2.0 = slightly lower for warmth
TTS_VOLUME_GAIN_DB=0.0  # Volume adjustment in dB (-96 to +16): 0.0 = natural volume
# Note: Audio is automatically peak-normalized to 1.0 to match reference samples

# Google Cloud Project ID (from Google Cloud Console)
GOOGLE_CLOUD_PROJECT_ID=your-project-id-here

# Path to Google Cloud service account JSON key file
# Create service account: https://console.cloud.google.com/iam-admin/serviceaccounts
# Download JSON key and specify path here
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json

# ============================================================================
# Model Configuration
# ============================================================================
# Embedding model for RAG
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Speech-to-Text model (Whisper)
STT_MODEL_NAME=large-v2

# ============================================================================
# RAG Configuration
# ============================================================================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_K=4

# ============================================================================
# LLM Generation Settings
# ============================================================================
LLM_MAX_TOKENS=150
LLM_TEMPERATURE=0.9
LLM_CONTEXT_LENGTH=2048

# ============================================================================
# Conversation Settings
# ============================================================================
MAX_CONVERSATION_HISTORY=10
SESSION_TIMEOUT_MINUTES=30

# ============================================================================
# API Settings
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ============================================================================
# CORS Settings
# ============================================================================
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:5174"]

# ============================================================================
# Audio Settings
# ============================================================================
AUDIO_SAMPLE_RATE=16000
AUDIO_FORMAT=wav
VAD_SILENCE_THRESHOLD=0.5
VAD_SILENCE_DURATION=1.0
